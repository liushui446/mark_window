  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #b8cce4;
}
QGroupBox {
    background-color: #b8cce4;
    border: 1px solid #7f9db9;
    border-radius: 3px;
    margin-top: 10px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #000000;
}
QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f0f0f0, stop:1 #c0c0c0);
    border: 1px solid #707070;
    border-radius: 3px;
    padding: 4px 8px;
    min-height: 20px;
}
QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #e0e0e0, stop:1 #b0b0b0);
}
QPushButton:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #c0c0c0, stop:1 #a0a0a0);
}
QPushButton#pushButton_5, QPushButton#pushButton_2 {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #7f9db9, stop:1 #5f7d99);
    color: white;
}
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: white;
    border: 1px solid #7f9db9;
    border-radius: 2px;
    padding: 2px;
}
QCheckBox {
    spacing: 5px;
}
QSlider::groove:horizontal {
    border: 1px solid #999999;
    height: 8px;
    background: #b8cce4;
    margin: 2px 0;
    border-radius: 4px;
}
QSlider::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #5c8a8a, stop:1 #3a6a6a);
    border: 1px solid #3a6a6a;
    width: 14px;
    margin: -4px 0;
    border-radius: 7px;
}
QTableWidget {
    background-color: white;
    gridline-color: #c0c0c0;
}
QTableWidget::item {
    padding: 2px;
}
QHeaderView::section {
    background-color: #e0e0e0;
    border: 1px solid #c0c0c0;
    padding: 4px;
}
</string>
