      <string>使用说明</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayout_2">
      <item>
       <widget class="QLabel" name="label_instruction">
        <property name="text">
         <string>1. 使用鼠标左键拖动框选需要忽略的区域
2. 右键点击选中的区域，选择&quot;保存选中区域&quot;
3. 可以框选多个忽略区域
4. 点击&quot;清除所有&quot;可以删除所有忽略区域
5. 使用鼠标滚轮可以缩放图像
6. 完成后点击&quot;确定&quot;保存设置</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
