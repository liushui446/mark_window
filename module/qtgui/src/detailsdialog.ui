  <property name="styleSheet">
   <string notr="true">QDialog {
    background-color: #b8cce4;
}
QGroupBox {
    background-color: #b8cce4;
    border: 1px solid #7f9db9;
    border-radius: 3px;
    margin-top: 10px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #000000;
}
QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f0f0f0, stop:1 #c0c0c0);
    border: 1px solid #707070;
    border-radius: 3px;
    padding: 4px 8px;
    min-height: 20px;
}
QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #e0e0e0, stop:1 #b0b0b0);
}
QPushButton:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #c0c0c0, stop:1 #a0a0a0);
}
QTextEdit {
    background-color: white;
    border: 1px solid #7f9db9;
    border-radius: 2px;
}
</string>
